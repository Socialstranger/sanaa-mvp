{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    

    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,

    "resolveJsonModule": true,

    "types": ["node"]
  },

  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  
  "exclude": ["node_modules", "dist"]
}